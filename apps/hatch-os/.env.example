# RunPod Serverless A100 FP8 (temp). Do not commit the key.
HATCH_LLM_BASE_URL=https://api.runpod.ai/v2/diqb3ykkxo0i16/openai/v1
HATCH_LLM_MODEL=Qwen/Qwen3.8-27B-FP8
HATCH_LLM_API_KEY=
HATCH_LLM_PROVIDER=openai-compatible

# Agent / tools (Hermes). Unset → agent turns use HATCH_LLM_* (Qwen).
HATCH_AGENT_LLM_BASE_URL=https://api.runpod.ai/v2/gy5a9f9lpjz2y7/openai/v1
HATCH_AGENT_LLM_MODEL=NousResearch/Hermes-4.3-36B
HATCH_AGENT_LLM_API_KEY=
HATCH_AGENT_LLM_PROVIDER=openai-compatible

# Pictures. Unset = the phone reads text out of the photo (OCR) and the text model answers.
# Set these to send the picture to an open-weight vision model you already run.
# Qwen2.5-VL, Llama 3.2 Vision, or Gemma 3 on an OpenAI-compatible /v1.
# A RunPod-style /v2/<id> URL uses the same async job path as chat.
# Do not point this at OpenAI, Anthropic, Bedrock, or Google.
# HATCH_VISION_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
# HATCH_VISION_BASE_URL=https://api.runpod.ai/v2/<vision-endpoint>/openai/v1
# HATCH_VISION_API_KEY=
# HATCH_VISION_PROVIDER=openai-compatible
# BASE_URL falls back to HATCH_LLM_BASE_URL. API_KEY falls back to HATCH_LLM_API_KEY.

# qwen/qwen3.8-27b 500s on this worker — use Qwen/Qwen3.8-27B-FP8.
# Local Ollama is primary only when HATCH_LLM_BASE_URL points at it.
# Remote (RunPod) does not auto-hop to Ollama; opt in with HATCH_LLM_ALLOW_OLLAMA_FALLBACK=1
# Appliance later: same vars → box vLLM /v1

# Walk the interface without calling a model. 1 = scripted replies, action cards, and approvals.
# HATCH_DEMO_MODE=1

# Vault encryption key. 64 hex chars, 32-byte base64, or a passphrase. Never commit a real key.
# HATCH_VAULT_KEY=

# Telegram dogfood (@Hatchboundariesbot). Placeholders only — never commit the token.
HATCH_TELEGRAM_BOT_TOKEN=
HATCH_TELEGRAM_ALLOWLIST=
HATCH_TELEGRAM_DEFAULT_DEPT=little-elm
