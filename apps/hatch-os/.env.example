# Copy to .env.local. See README and INTERIM_INFERENCE.md.
# Remote overnight: https://<host>/v1 + HATCH_LLM_API_KEY (required).
# Local fallback: http://127.0.0.1:11434 + qwen3:8b (no key).
# Appliance later: same vars → vLLM OpenAI-compatible URL.

HATCH_LLM_BASE_URL=http://127.0.0.1:11434
HATCH_LLM_MODEL=qwen3:8b
HATCH_LLM_API_KEY=
HATCH_LLM_PROVIDER=openai-compatible

# Optional adapters
STATUS_URL=http://127.0.0.1:8090
RAG_URL=http://127.0.0.1:8091
