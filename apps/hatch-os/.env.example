# RunPod Serverless A100 FP8 (temp). Do not commit the key.
HATCH_LLM_BASE_URL=https://api.runpod.ai/v2/diqb3ykkxo0i16/openai/v1
HATCH_LLM_MODEL=Qwen/Qwen3.8-27B-FP8
HATCH_LLM_API_KEY=
HATCH_LLM_PROVIDER=openai-compatible

# Agent / tools (Hermes). Unset → agent turns use HATCH_LLM_* (Qwen).
HATCH_AGENT_LLM_BASE_URL=https://api.runpod.ai/v2/gy5a9f9lpjz2y7/openai/v1
HATCH_AGENT_LLM_MODEL=NousResearch/Hermes-4.3-36B
HATCH_AGENT_LLM_API_KEY=
HATCH_AGENT_LLM_PROVIDER=openai-compatible

# qwen/qwen3.8-27b 500s on this worker — use Qwen/Qwen3.8-27B-FP8.
# Local Ollama is primary only when HATCH_LLM_BASE_URL points at it.
# Remote (RunPod) does not auto-hop to Ollama; opt in with HATCH_LLM_ALLOW_OLLAMA_FALLBACK=1
# Appliance later: same vars → box vLLM /v1

# Telegram dogfood (@Hatchboundariesbot). Placeholders only — never commit the token.
HATCH_TELEGRAM_BOT_TOKEN=
HATCH_TELEGRAM_ALLOWLIST=
