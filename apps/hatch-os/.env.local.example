# RunPod Serverless Qwen3.8-27B on A100 FP8 (dogfood). Never commit the key.
# Working model id is Qwen/Qwen3.8-27B-FP8 — qwen/qwen3.8-27b 500s on this endpoint.
HATCH_LLM_BASE_URL=https://api.runpod.ai/v2/diqb3ykkxo0i16/openai/v1
HATCH_LLM_MODEL=Qwen/Qwen3.8-27B-FP8
HATCH_LLM_API_KEY=
HATCH_LLM_PROVIDER=openai-compatible

# Agent / tool loop — Hermes 4.3 36B. If these are unset, Chat tools fall back to HATCH_LLM_* (Qwen).
HATCH_AGENT_LLM_BASE_URL=https://api.runpod.ai/v2/gy5a9f9lpjz2y7/openai/v1
HATCH_AGENT_LLM_MODEL=NousResearch/Hermes-4.3-36B
HATCH_AGENT_LLM_API_KEY=
HATCH_AGENT_LLM_PROVIDER=openai-compatible

# Optional vision. Unset = OCR on the phone. Same OpenAI-compatible shape as chat.
# HATCH_VISION_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
# HATCH_VISION_BASE_URL=https://api.runpod.ai/v2/<vision-endpoint>/openai/v1
# HATCH_VISION_API_KEY=
# HATCH_VISION_PROVIDER=openai-compatible

# Point HATCH_LLM_BASE_URL at Ollama to use local as primary. Remote (RunPod) does not
# auto-hop to Ollama on timeout/HTTP — opt in only:
# HATCH_LLM_ALLOW_OLLAMA_FALLBACK=1
# HATCH_LLM_BASE_URL=http://127.0.0.1:11434
# HATCH_LLM_MODEL=qwen3:8b
# HATCH_LLM_API_KEY=

# Walk the interface without calling RunPod. Scripted replies only.
# HATCH_DEMO_MODE=1

# Encrypts vault items at rest. 64 hex chars or a long passphrase. Never commit a real key.
# HATCH_VAULT_KEY=

# Telegram dogfood (@Hatchboundariesbot). Never commit the token.
HATCH_TELEGRAM_BOT_TOKEN=
# Optional comma-separated Telegram user ids. Empty = lock to the first /start.
HATCH_TELEGRAM_ALLOWLIST=
# Sticky write department for Telegram Enterprise drafts (little-elm | prosper | hq-ops).
HATCH_TELEGRAM_DEFAULT_DEPT=little-elm
