# Interim inference — laptop Ollama (no appliance yet).
# Same three vars later point at the appliance vLLM OpenAI-compatible endpoint.
HATCH_LLM_BASE_URL=http://127.0.0.1:11434
HATCH_LLM_MODEL=qwen3.8
# Optional. Ollama ignores this. Appliance / vLLM may require it.
HATCH_LLM_API_KEY=

# Optional dry-run adapters. Leave unset to use the in-app store.
# STATUS_URL=http://127.0.0.1:8090
# RAG_URL=http://127.0.0.1:8091
