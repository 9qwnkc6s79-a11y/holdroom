# RunPod Serverless Qwen3.8-27B on A100 FP8 (dogfood). Never commit the key.
# Working model id is Qwen/Qwen3.8-27B-FP8 — qwen/qwen3.8-27b 500s on this endpoint.
HATCH_LLM_BASE_URL=https://api.runpod.ai/v2/diqb3ykkxo0i16/openai/v1
HATCH_LLM_MODEL=Qwen/Qwen3.8-27B-FP8
HATCH_LLM_API_KEY=
HATCH_LLM_PROVIDER=openai-compatible

# Agent / tool loop — Hermes 4.3 36B. Paste the RunPod Serverless endpoint id below.
# If these are unset, Chat tools fall back to HATCH_LLM_* (Qwen).
HATCH_AGENT_LLM_BASE_URL=https://api.runpod.ai/v2/<HERMES_ENDPOINT>/openai/v1
HATCH_AGENT_LLM_MODEL=NousResearch/Hermes-4.3-36B
HATCH_AGENT_LLM_API_KEY=
HATCH_AGENT_LLM_PROVIDER=openai-compatible

# Local fallback if RunPod is unset or down (16 GB Mac):
# HATCH_LLM_BASE_URL=http://127.0.0.1:11434
# HATCH_LLM_MODEL=qwen3:8b
# HATCH_LLM_API_KEY=

# Telegram dogfood (@Hatchboundariesbot). Never commit the token.
HATCH_TELEGRAM_BOT_TOKEN=
# Optional comma-separated Telegram user ids. Empty = lock to the first /start.
HATCH_TELEGRAM_ALLOWLIST=
