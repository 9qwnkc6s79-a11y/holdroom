{
  "cli": {
    "version": ">= 16.17.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_HATCH_API_BASE": "https://hatch-os-beta.vercel.app"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_HATCH_API_BASE": "https://hatch-os-beta.vercel.app"
      }
    },
    "production": {
      "autoIncrement": false,
      "env": {
        "EXPO_PUBLIC_HATCH_API_BASE": "https://hatch-os-beta.vercel.app"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6838890464"
      }
    }
  }
}
